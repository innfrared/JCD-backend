# Django
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: override Django CONN_MAX_AGE (seconds). With Supabase pooler, defaults to 60 if unset.
DB_CONN_MAX_AGE=
# With Supabase transaction pooler (pgBouncer), keep True to avoid server-side cursors (default True).
DB_DISABLE_SERVER_SIDE_CURSORS=True

# Frontend origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Auth cookies
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=jc_access
AUTH_REFRESH_COOKIE_NAME=jc_refresh
AUTH_ACCESS_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_PATH=/api/auth/

# Security headers
SECURITY_CSP_REPORT_ONLY=default-src 'self'

# JWT lifetimes
SIMPLE_JWT_ACCESS_MINUTES=15
SIMPLE_JWT_REFRESH_DAYS=7

# Cache (optional). Omit CACHE_BACKEND to use LocMemCache (default; good for Render without Redis).
# For local file cache instead:
# CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
# CACHE_LOCATION=.django_cache
CACHE_TIMEOUT_SECONDS=3600
CACHE_MAX_ENTRIES=10000

# API throttling
DRF_THROTTLE_ANON=120/min
DRF_THROTTLE_USER=600/min
DRF_THROTTLE_AUTH_LOGIN=10/min
DRF_THROTTLE_AUTH_REGISTER=5/min
DRF_THROTTLE_AUTH_REFRESH=30/min
DRF_THROTTLE_AUTH_LOGOUT=30/min
DRF_THROTTLE_CATALOG_LIST=120/min
DRF_THROTTLE_HOMEPAGE=120/min

# Request body limits
DATA_UPLOAD_MAX_MEMORY_SIZE=2097152
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152

# Production cross-site note:
# Set DEBUG=False, AUTH_COOKIE_SAMESITE=None and AUTH_COOKIE_SECURE=True
